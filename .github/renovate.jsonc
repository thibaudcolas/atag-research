{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
  ],

  // Run about bi-weekly.
  "schedule": ["* * 3,22 * *"],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 10,

  "labels": ["dependencies"],

  "minimumReleaseAge": "7 days",

  // Periodically refresh lockfiles to catch transitive dependency updates.
  // Renovate keeps `uv.lock` in sync with `pyproject.toml` and `pnpm-lock.yaml` with `package.json`.
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * 3,22 * *"],
  },

  "packageRules": [
    // Auto-merge GitHub Actions updates.
    {
      "matchCategories": ["ci"],
      "automerge": true,
      "groupName": "CI configuration dependencies",
    },

    // Auto-merge npm package updates.
    {
      "matchManagers": ["npm"],
      "automerge": true,
    },

    // Auto-merge all Python dependencies…
    {
      "matchManagers": ["pep621"],
      "automerge": true,
    },

    // …except for packages whose bounds are intentionally conservative:
    // - mypy is pinned to the version this project's strict settings were validated against.
    // - vale is pinned to the CLI version the Python wrapper downloads.
    // - ruff and ty participate in the lockstep lint + type-check pipeline (justfile, CI, prek).
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": ["mypy", "vale", "ruff", "ty"],
      "enabled": false,
    },

    // Keep the ruff version used by prek hooks in step with the one in pyproject.toml.
    {
      "matchManagers": ["pre-commit"],
      "matchDepNames": ["ruff-pre-commit"],
      "enabled": true,
    },
  ],
}
